{
    "name": "React TypeScript Application",

    "image": "mcr.microsoft.com/devcontainers/base:ubuntu",

    "features": {
        "ghcr.io/devcontainers/features/docker-in-docker:2": {}
    },

    "forwardPorts": [
        3000
    ],

    "portsAttributes": {
        "3000": {
            "label": "React Application",
            "onAutoForward": "openBrowser"
        }
    },

    "postCreateCommand": "docker build -t react-app:dev .",

    "postStartCommand": "docker rm -f react-app 2>/dev/null || true && docker run -d --name react-app -p 3000:80 react-app:dev"
}